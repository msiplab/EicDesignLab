<?xml version="1.0"?>
<!--
  差動2輪のライントレーサ
  - 座標系（REP 103）：x 軸が前，y 軸が左．原点は車輪間の中心の真下（床の高さ）
  - 車輪：直径 58 mm，車輪間の距離 100 mm（mbd_phs3 と同じ）
  - 前方にボールキャスター（摩擦なし）
  - フォトリフレクタの代わりに，前方の床を真下に見る小さなカメラを置く．
    カメラ画像のうち，4つのフォトリフレクタの位置に当たる画素の明るさから
    /photorefs を求める（photoref_node）．カメラの位置と画角は，床の
    x = 0.10〜0.12 m，y = -0.08〜0.08 m の範囲が写るように決めている．
-->
<sdf version="1.9">
  <model name="line_follower">

    <link name="base_link">
      <pose>0 0 0.029 0 0 0</pose>
      <inertial>
        <pose>0.03 0 0.012 0 0 0</pose>
        <mass>0.30</mass>
        <inertia>
          <ixx>0.00014</ixx><iyy>0.00043</iyy><izz>0.00055</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis">
        <pose>0.03 0 0.012 0 0 0</pose>
        <geometry><box><size>0.13 0.07 0.02</size></box></geometry>
        <material>
          <ambient>1.0 0.5 0.0 1</ambient>
          <diffuse>1.0 0.5 0.0 1</diffuse>
        </material>
      </visual>
      <collision name="chassis">
        <pose>0.03 0 0.012 0 0 0</pose>
        <geometry><box><size>0.13 0.07 0.02</size></box></geometry>
      </collision>
      <!-- フォトリフレクタの位置の目印（表示のみ） -->
      <visual name="pr1"><pose>0.120 0.060 -0.026 0 0 0</pose>
        <geometry><sphere><radius>0.003</radius></sphere></geometry>
        <material><ambient>0.8 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse></material></visual>
      <visual name="pr2"><pose>0.100 0.020 -0.026 0 0 0</pose>
        <geometry><sphere><radius>0.003</radius></sphere></geometry>
        <material><ambient>0.8 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse></material></visual>
      <visual name="pr3"><pose>0.100 -0.020 -0.026 0 0 0</pose>
        <geometry><sphere><radius>0.003</radius></sphere></geometry>
        <material><ambient>0.8 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse></material></visual>
      <visual name="pr4"><pose>0.120 -0.060 -0.026 0 0 0</pose>
        <geometry><sphere><radius>0.003</radius></sphere></geometry>
        <material><ambient>0.8 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse></material></visual>
    </link>

    <!-- 左の車輪 -->
    <link name="left_wheel">
      <pose>0 0.05 0.029 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.0000045</ixx><iyy>0.0000084</iyy><izz>0.0000045</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.029</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.029</radius><length>0.012</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>

    <!-- 右の車輪 -->
    <link name="right_wheel">
      <pose>0 -0.05 0.029 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.0000045</ixx><iyy>0.0000084</iyy><izz>0.0000045</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.029</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.029</radius><length>0.012</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>

    <!-- ボールキャスター（摩擦なし） -->
    <link name="caster">
      <pose>0.08 0 0.015 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0000009</ixx><iyy>0.0000009</iyy><izz>0.0000009</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="ball">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
      <collision name="ball">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <!-- フォトリフレクタの代わりのカメラ（床を真下に見る） -->
    <link name="photoref_camera_link">
      <pose>0.11 0 0.15 0 1.5708 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0000001</ixx><iyy>0.0000001</iyy><izz>0.0000001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="photoref_camera" type="camera">
        <camera>
          <!-- 高さ 0.15 m から床の幅 0.16 m が写る画角：2 atan(0.08/0.15) -->
          <horizontal_fov>1.0808</horizontal_fov>
          <image>
            <width>64</width>
            <height>8</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.01</near><far>1.0</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/photoref_camera</topic>
      </sensor>
    </link>
    <joint name="photoref_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>photoref_camera_link</child>
    </joint>

    <!-- 左右の車輪の回転速度による駆動（/cmd_vel） -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.10</wheel_separation>
      <wheel_radius>0.029</wheel_radius>
      <topic>/model/line_follower/cmd_vel</topic>
      <odom_topic>/model/line_follower/diff_drive_odometry</odom_topic>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>40.0</max_angular_acceleration>
      <min_angular_acceleration>-40.0</min_angular_acceleration>
    </plugin>

    <!-- 車体の位置と姿勢（コースの座標系 map） -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_topic>/model/line_follower/odometry</odom_topic>
    </plugin>

    <!-- 車輪の関節の角度と角速度 -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/line_follower/joint_state</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>

  </model>
</sdf>
