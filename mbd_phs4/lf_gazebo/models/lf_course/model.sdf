<?xml version="1.0"?>
<!--
  ライントレースのコース
  コース画像（2.5 mm/pixel，640 x 360 pixel 相当）を 1.6 m x 0.9 m の床に貼る．
  座標は mbd_phs3 と同じ（x 軸が右，y 軸が上，原点はコースの左下）．
-->
<sdf version="1.9">
  <model name="lf_course">
    <static>true</static>
    <link name="floor">
      <collision name="collision">
        <pose>0.8 0.45 -0.005 0 0 0</pose>
        <geometry>
          <box><size>3.0 2.0 0.01</size></box>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="course">
        <pose>0 0 0.0005 0 0 0</pose>
        <geometry>
          <mesh><uri>model://lf_course/meshes/course.obj</uri></mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://lf_course/materials/textures/course2025.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="surround">
        <pose>0.8 0.45 -0.0005 0 0 0</pose>
        <geometry>
          <box><size>3.0 2.0 0.001</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
